<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OsuCursorWin</AssemblyName>
    <RootNamespace>OsuCursorWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>1.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="1.ico">
      <LogicalName>OsuCursorWin.Images.AppIcon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="cursor-tap.wav">
      <LogicalName>OsuCursorWin.Audio.cursorTap.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="default-hover.wav">
      <LogicalName>OsuCursorWin.Audio.defaultHover.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\cursor.png">
      <LogicalName>OsuCursorWin.Images.cursor.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\cursor-additive.png">
      <LogicalName>OsuCursorWin.Images.cursorAdditive.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\text.cur">
      <LogicalName>OsuCursorWin.Cursors.text.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\hand.cur">
      <LogicalName>OsuCursorWin.Cursors.hand.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\cross.cur">
      <LogicalName>OsuCursorWin.Cursors.cross.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\move.cur">
      <LogicalName>OsuCursorWin.Cursors.move.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\horz.cur">
      <LogicalName>OsuCursorWin.Cursors.horz.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\vert.cur">
      <LogicalName>OsuCursorWin.Cursors.vert.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\dgn1.cur">
      <LogicalName>OsuCursorWin.Cursors.dgn1.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\dgn2.cur">
      <LogicalName>OsuCursorWin.Cursors.dgn2.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\link.cur">
      <LogicalName>OsuCursorWin.Cursors.link.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\unavailiable.cur">
      <LogicalName>OsuCursorWin.Cursors.unavailiable.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\alternate.cur">
      <LogicalName>OsuCursorWin.Cursors.alternate.cur</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\ex\work.ani">
          <LogicalName>OsuCursorWin.Cursors.work.ani</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\assets\ex\busy.png">
          <LogicalName>OsuCursorWin.Images.busy.png</LogicalName>
        </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
