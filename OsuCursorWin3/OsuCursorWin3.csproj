<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OsuCursorWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <UseWPF>false</UseWPF>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OsuCursorWin</AssemblyName>
    <ApplicationIcon>1.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Point the Appx/PRI build tasks at the installed Visual Studio 2022
         (dotnet CLI doesn't ship these tasks, so PriGen would otherwise fail). -->
    <AppxMSBuildToolsPath>C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <!-- Embedded resources (same as original) -->
  <ItemGroup>
    <EmbeddedResource Include="1.ico">
      <LogicalName>OsuCursorWin.Images.AppIcon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\cursor.png">
      <LogicalName>OsuCursorWin.Images.cursor.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\cursor-additive.png">
      <LogicalName>OsuCursorWin.Images.cursorAdditive.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\ex\busy.png">
      <LogicalName>OsuCursorWin.Images.busy.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>